# syntax=docker/dockerfile:1
#
# Remote runtime sandbox: Orca (onorca.dev) headless server + bun, uv, Python 3.12, Go 1.26, JDK 25.
#
# Base: Ubuntu 24.04 (noble) — ships Python 3.12 in main and the t64-suffixed
# Electron libraries that `orca serve` requires (per the Orca headless Linux guide).
#
# Build (multi-arch, push to registry):
#   docker buildx build --builder multi-arch --platform linux/amd64,linux/arm64 \
#     -t 10.10.111.134:5000/ade-sandbox/orca:latest --push -f Dockerfile.orca .
#
# Run (unprivileged; tini inside the image acts as PID 1 / init):
#   docker run -d --name orca-runtime \
#     -p 6768:6768 \
#     -e ORCA_PAIRING_ADDRESS=host.example.com \
#     10.10.111.134:5000/ade-sandbox/orca:latest
#
# Notes:
#   - Orca starts its own Xvfb on :99 when DISPLAY is unset; never set DISPLAY here.
#   - Chromium's namespace sandbox is blocked by Docker's default seccomp
#     profile, so ELECTRON_DISABLE_SANDBOX=1 is baked in (the container already
#     runs as a non-root user). To re-enable it, run with a permissive seccomp
#     profile that allows unshare(CLONE_NEWUSER) and unset the variable.
#   - For full reproducibility, replace image tags below with digests
#     (docker buildx imagetools inspect <image> -> repo@sha256:...).

ARG BASE_IMAGE=ubuntu:24.04

# ---------------------------------------------------------------------------
# Stage 1: builder — download, checksum-verify, and extract artifacts
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS builder

ARG TARGETARCH
ARG GO_VERSION=1.26.8
ARG GO_SHA256_AMD64=d0f743b33e8d8945e6b1f432edd15785c70507121d6e2a723b21285eddf8b57b
ARG GO_SHA256_ARM64=211ffced9dcb9633a55eac6364816ec0ddd951389a740e88fa8b3337971bdda0

ARG JDK_VERSION=25.0.4.1+1
ARG JDK_SHA256_AMD64=dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e
ARG JDK_SHA256_ARM64=69df11a02cfa3ef7d7ca645e03edce6778ec090e100f6ae2b42097865730ac52

ARG ORCA_VERSION=v1.4.223
ARG ORCA_DEB_SHA512_AMD64=d742411261b4ae3f384b380575547eb5954a9c0dbf8949094749d8eea67e797270fdae0e80c09c89d966e267adb3600412e1be4e3c62fa9f4d8fe822b775177f
ARG ORCA_DEB_SHA512_ARM64=7f7cb0f95d225b231b4735888e85b522bfeb42da572b4b381175cac8a01e86cb64220b4a3ee2f7e92c96be0dc42ae822f6a42dc80794da4dbcd72f8e095cc81c

ARG KUBECTL_VERSION=v1.37.1
ARG KUBECTL_SHA256_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
ARG KUBECTL_SHA256_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7

ARG GH_VERSION=2.102.0
ARG GH_SHA256_AMD64=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
ARG GH_SHA256_ARM64=7862c86c72f43df3a2d93ddde6f473285b4e2af61b494849846827e513ef6484

ARG NODE_VERSION=24.21.0
ARG NODE_SHA256_AMD64=6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff
ARG NODE_SHA256_ARM64=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5

RUN <<'EOF'
set -eu
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl file
rm -rf /var/lib/apt/lists/*
EOF

# --- Go ---------------------------------------------------------------------
RUN <<'EOF'
set -eu
case "${TARGETARCH}" in
  amd64) GO_ARCH=amd64; GO_SHA="${GO_SHA256_AMD64}" ;;
  arm64) GO_ARCH=arm64; GO_SHA="${GO_SHA256_ARM64}" ;;
  *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;;
esac
curl -fsSL --retry 3 -o /tmp/go.tar.gz \
  "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz"
echo "${GO_SHA}  /tmp/go.tar.gz" | sha256sum -c -
mkdir -p /opt/go
tar -xzf /tmp/go.tar.gz -C /opt/go --strip-components=1
rm /tmp/go.tar.gz
EOF

# --- JDK 25 (Eclipse Temurin LTS) --------------------------------------------
RUN <<'EOF'
set -eu
case "${TARGETARCH}" in
  amd64) JDK_PKG="OpenJDK25U-jdk_x64_linux_hotspot_25.0.4.1_1.tar.gz"; JDK_SHA="${JDK_SHA256_AMD64}" ;;
  arm64) JDK_PKG="OpenJDK25U-jdk_aarch64_linux_hotspot_25.0.4.1_1.tar.gz"; JDK_SHA="${JDK_SHA256_ARM64}" ;;
  *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;;
esac
curl -fsSL --retry 3 -o /tmp/jdk.tar.gz \
  "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-${JDK_VERSION}/${JDK_PKG}"
echo "${JDK_SHA}  /tmp/jdk.tar.gz" | sha256sum -c -
mkdir -p /opt/java
tar -xzf /tmp/jdk.tar.gz -C /opt/java --strip-components=1
rm /tmp/jdk.tar.gz
EOF

# --- Orca (headless runtime via .deb: pure extraction, no arch exec at build) -
# The deb ships /opt/Orca/orca-ide (Electron binary) and the resources/bin/orca-ide
# CLI shim that the upstream postinst symlinks into PATH for headless servers.
RUN <<'EOF'
set -eu
case "${TARGETARCH}" in
  amd64) ORCA_DEB="orca-ide_${ORCA_VERSION#v}_amd64.deb"; ORCA_SHA="${ORCA_DEB_SHA512_AMD64}" ;;
  arm64) ORCA_DEB="orca-ide_${ORCA_VERSION#v}_arm64.deb"; ORCA_SHA="${ORCA_DEB_SHA512_ARM64}" ;;
  *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;;
esac
curl -fsSL --retry 3 -o "/tmp/${ORCA_DEB}" \
  "https://github.com/stablyai/orca/releases/download/${ORCA_VERSION}/${ORCA_DEB}"
echo "${ORCA_SHA}  /tmp/${ORCA_DEB}" | sha512sum -c -
mkdir -p /stage
dpkg-deb -x "/tmp/${ORCA_DEB}" /stage
rm -f "/tmp/${ORCA_DEB}"
# Match upstream postinst: setuid sandbox helper + world-readable app tree.
[ -f /stage/opt/Orca/chrome-sandbox ] && chmod 4755 /stage/opt/Orca/chrome-sandbox || true
chmod -R a+rX /stage/opt/Orca
EOF

# --- kubectl ------------------------------------------------------------------
RUN <<'EOF'
set -eu
case "${TARGETARCH}" in
  amd64) KCTL_ARCH=amd64; KCTL_SHA="${KUBECTL_SHA256_AMD64}" ;;
  arm64) KCTL_ARCH=arm64; KCTL_SHA="${KUBECTL_SHA256_ARM64}" ;;
  *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;;
esac
curl -fsSL --retry 3 -o /tmp/kubectl \
  "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${KCTL_ARCH}/kubectl"
echo "${KCTL_SHA}  /tmp/kubectl" | sha256sum -c -
chmod 0755 /tmp/kubectl
mkdir -p /staging/bin
mv /tmp/kubectl /staging/bin/kubectl
EOF

# --- GitHub CLI (gh) ----------------------------------------------------------
RUN <<'EOF'
set -eu
case "${TARGETARCH}" in
  amd64) GH_ARCH=amd64; GH_SHA="${GH_SHA256_AMD64}" ;;
  arm64) GH_ARCH=arm64; GH_SHA="${GH_SHA256_ARM64}" ;;
  *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;;
esac
curl -fsSL --retry 3 -o /tmp/gh.tar.gz \
  "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${GH_ARCH}.tar.gz"
echo "${GH_SHA}  /tmp/gh.tar.gz" | sha256sum -c -
mkdir -p /staging/bin
tar -xzf /tmp/gh.tar.gz -C /tmp
mv "/tmp/gh_${GH_VERSION}_linux_${GH_ARCH}/bin/gh" /staging/bin/gh
chmod 0755 /staging/bin/gh
rm -rf "/tmp/gh_${GH_VERSION}_linux_${GH_ARCH}" /tmp/gh.tar.gz
EOF

# --- Node.js LTS (npm is the distribution channel for the agent CLIs) --------
RUN <<'EOF'
set -eu
case "${TARGETARCH}" in
  amd64) NODE_ARCH=x64;   NODE_SHA="${NODE_SHA256_AMD64}" ;;
  arm64) NODE_ARCH=arm64; NODE_SHA="${NODE_SHA256_ARM64}" ;;
  *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;;
esac
curl -fsSL --retry 3 -o /tmp/node.tar.gz \
  "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz"
echo "${NODE_SHA}  /tmp/node.tar.gz" | sha256sum -c -
mkdir -p /opt/node
tar -xzf /tmp/node.tar.gz -C /opt/node --strip-components=1
rm /tmp/node.tar.gz
EOF

# ---------------------------------------------------------------------------
# Stage 2: runtime — minimal image, non-root user, Orca as the entrypoint
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS runtime

ARG GO_VERSION=1.26.8
ARG JDK_VERSION=25.0.4.1+1
ARG ORCA_VERSION=v1.4.223
ARG BUN_VERSION=1.4.2
ARG UV_VERSION=0.12.21
ARG CLAUDE_CODE_VERSION=2.1.295
ARG CODEX_VERSION=0.162.0
ARG OPENCODE_VERSION=1.18.35

# Runtime deps only: xvfb (Orca auto-starts it headless), the Electron shared
# libraries (Ubuntu 24.04 t64 names), plus basic sandbox ergonomics.
RUN <<'EOF'
set -eu
apt-get update
apt-get install -y --no-install-recommends \
  ca-certificates curl jq git openssh-client tini \
  python3.12 python3.12-venv python3-pip \
  xvfb libgtk-3-0t64 libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 \
  libgbm1 libasound2t64 libxtst6 libcups2t64 libdrm2 libxkbcommon0 \
  libpango-1.0-0 libcairo2 libatspi2.0-0t64 libxcomposite1 libxdamage1 \
  libxfixes3 libxrandr2 libxrender1 libx11-xcb1 libxcb-dri3-0 libxss1 zlib1g
rm -rf /var/lib/apt/lists/*
EOF

# Toolchains from builder (root-owned; the service user cannot tamper with them).
COPY --from=builder /opt/go   /opt/go
COPY --from=builder /opt/java /opt/java
COPY --from=builder /stage/opt/Orca /opt/Orca
COPY --from=builder /staging/bin/kubectl /usr/local/bin/kubectl
COPY --from=builder /staging/bin/gh     /usr/local/bin/gh

# Bun and uv from their official images (single static binaries).
COPY --from=oven/bun:1.4.2            /usr/local/bin/bun /usr/local/bin/bun
COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /bin/uv
COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uvx /bin/uvx

# Node.js LTS + the agent CLIs. npm's global prefix is the node tree itself, so
# the binaries land in /opt/node/bin (root-owned; the service user can't upgrade
# them out from under the pin).
COPY --from=builder /opt/node /opt/node
RUN <<'EOF'
set -eu
export PATH="/opt/node/bin:${PATH}"
npm install -g --no-audit --no-fund \
  "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
  "@openai/codex@${CODEX_VERSION}" \
  "opencode-ai@${OPENCODE_VERSION}"
npm cache clean --force
rm -rf /root/.npm
EOF

# Expose the Orca CLI shim on PATH (same symlink the upstream deb postinst makes).
RUN ln -s /opt/Orca/resources/bin/orca-ide /usr/local/bin/orca-ide

# Dedicated non-root service user (fixed UID/GID for volume permission sanity).
# Ubuntu's base image ships a default 'ubuntu' user at 1000:1000 — remove it first.
RUN <<'EOF'
set -eu
userdel -r ubuntu 2>/dev/null || true
groupdel ubuntu 2>/dev/null || true
groupadd --gid 1000 orca
useradd --uid 1000 --gid orca --create-home --shell /bin/bash orca
mkdir -p /home/orca/workspace /home/orca/go/bin
chown -R orca:orca /home/orca
EOF

ENV JAVA_HOME=/opt/java \
    GOROOT=/opt/go \
    GOPATH=/home/orca/go \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/go/bin:/opt/java/bin:/opt/node/bin:/home/orca/.bun/bin:/home/orca/.local/bin:/home/orca/go/bin \
    LIBGL_ALWAYS_SOFTWARE=1 \
    PYTHONUNBUFFERED=1 \
    BUN_INSTALL=/home/orca/.bun \
    UV_LINK_MODE=copy \
    ORCA_PORT=6768 \
    ELECTRON_DISABLE_SANDBOX=1

# Orca entrypoint: default to headless `serve --json`; any args override it.
COPY <<-'EOF' /usr/local/bin/orca-entrypoint.sh
#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
  set -- serve --port "${ORCA_PORT:-6768}" --json
  if [ -n "${ORCA_PAIRING_ADDRESS:-}" ]; then
    set -- "$@" --pairing-address "${ORCA_PAIRING_ADDRESS}"
  fi
fi

exec orca-ide "$@"
EOF
RUN chmod 755 /usr/local/bin/orca-entrypoint.sh

USER orca
WORKDIR /home/orca/workspace

EXPOSE 6768

# TCP liveness on the Orca WebSocket listener (no extra tooling needed).
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD bash -c "exec 3<>/dev/tcp/127.0.0.1/${ORCA_PORT:-6768}" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/orca-entrypoint.sh"]
